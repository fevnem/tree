// Resource script for tree.exe: icon, version info, and the manifest that
// switches on comctl32 v6 + PerMonitorV2. Constants are inlined so llvm-rc does
// not need the Windows SDK headers on a Linux build host.

#define VS_VERSION_INFO 1
#define VFT_APP 0x00000001L
#define VFT2_UNKNOWN 0x00000000L
#define VOS_NT_WINDOWS32 0x00040004L
#define RT_MANIFEST 24

1 ICON "tree.ico"

1 RT_MANIFEST "tree.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,3,2,0
 PRODUCTVERSION 0,3,2,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "R"
            VALUE "FileDescription", "Tree - native Windows download manager"
            VALUE "FileVersion", "0.3.2.0"
            VALUE "InternalName", "tree"
            VALUE "LegalCopyright", "MIT Licence"
            VALUE "OriginalFilename", "tree.exe"
            VALUE "ProductName", "Tree"
            VALUE "ProductVersion", "0.3.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
